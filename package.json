{
    "name": "@codemind.ec/medusa-plugin-listmonk",
    "description": "Medusa v2 notification provider for Listmonk — transactional emails with template mapping for orders, payments, and receipts.",
    "version": "1.0.2",
    "author": "Kollor <dev@codemind.ec> (https://codemind.ec)",
    "license": "MIT",
    "main": "./.medusa/server/src/index.js",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "import": "./.medusa/server/src/index.js",
            "require": "./.medusa/server/src/index.js",
            "default": "./.medusa/server/src/index.js"
        },
        "./services/*": "./.medusa/server/src/services/*.js",
        "./admin": {
            "import": "./.medusa/server/src/admin/index.mjs",
            "require": "./.medusa/server/src/admin/index.js",
            "default": "./.medusa/server/src/admin/index.js"
        }
    },
    "scripts": {
        "build": "medusa plugin:build",
        "dev": "medusa plugin:develop",
        "prepublishOnly": "medusa plugin:build"
    },
    "devDependencies": {
        "@medusajs/admin-sdk": "2.13.3",
        "@medusajs/admin-shared": "2.13.3",
        "@medusajs/cli": "2.13.3",
        "@medusajs/framework": "2.13.3",
        "@medusajs/icons": "^2.13.3",
        "@medusajs/medusa": "2.13.3",
        "@medusajs/test-utils": "2.13.3",
        "@medusajs/ui": "^4.1.3",
        "@swc/core": "^1.7.28",
        "@types/node": "^20",
        "@types/react": "^18.3.3",
        "@types/react-dom": "^18.3.0",
        "prop-types": "^15.8.1",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "ts-node": "^10.9.2",
        "typescript": "^5",
        "vite": "^5.4.14",
        "yalc": "^1.0.0-pre.53"
    },
    "engines": {
        "node": ">=20"
    },
    "files": [
        ".medusa/server"
    ],
    "keywords": [
        "medusa",
        "medusa-plugin",
        "medusa-v2",
        "plugin",
        "listmonk",
        "notification",
        "email",
        "codemind",
        "kollor"
    ],
    "packageManager": "pnpm@9.15.9",
    "peerDependencies": {
        "@medusajs/admin-sdk": "2.13.3",
        "@medusajs/admin-shared": "2.13.3",
        "@medusajs/cli": "2.13.3",
        "@medusajs/framework": "2.13.3",
        "@medusajs/icons": "^2.13.3",
        "@medusajs/medusa": "2.13.3",
        "@medusajs/test-utils": "2.13.3",
        "@medusajs/ui": "^4.1.3"
    }
}
